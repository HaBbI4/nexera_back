# Конфигурация сервера
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15
SERVER_WRITE_TIMEOUT=15

# База данных PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=nexera_back
DB_SSL_MODE=disable

# Redis кеш
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Логирование
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=

# Хранилище медиа заказов (фото/видео)
# MEDIA_DRIVER: local | s3
MEDIA_DRIVER=local
MEDIA_MAX_FILE_SIZE_MB=20
MEDIA_LOCAL_PATH=./uploads

# Используются только при MEDIA_DRIVER=s3
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=

# Kafka (события по заказам, читаются, например, telegram-bot сервисом)
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=detailing-crm
KAFKA_TOPIC_ORDERS=orders

# Telegram-бот (используется только cmd/telegram-bot)
TELEGRAM_BOT_TOKEN=
