# Конфигурация сервера
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15
SERVER_WRITE_TIMEOUT=15

# База данных PostgreSQL
# DB_USER/DB_PASSWORD/DB_NAME используются и локальным go run, и docker-compose.yml
# (там они подставляются в postgres/migrate/app/telegram-bot через ${DB_USER} и т.п.,
# чтобы везде были одни и те же учетные данные вместо захардкоженных в compose-файле).
# DB_PORT=5433, т.к. docker-compose публикует Postgres на хосте именно на этот порт
# (5432 занят под internal docker-network между контейнерами, наружу пробрасывается 5433).
DB_HOST=localhost
DB_PORT=5433
DB_USER=nexera_back_user
DB_PASSWORD=nexera_back_pass
DB_NAME=nexera_back_db
DB_SSL_MODE=disable

# Redis кеш
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Логирование
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=

# Хранилище медиа заказов (фото/видео)
# MEDIA_DRIVER: local | s3
MEDIA_DRIVER=local
MEDIA_MAX_FILE_SIZE_MB=20
MEDIA_LOCAL_PATH=./uploads

# Используются только при MEDIA_DRIVER=s3
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=

# Kafka (события по заказам, читаются, например, telegram-bot сервисом)
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=detailing-crm
KAFKA_TOPIC_ORDERS=orders

# Telegram-бот (используется только cmd/telegram-bot)
TELEGRAM_BOT_TOKEN=

# JWT-аутентификация админ-панели
# Обязателен: приложение не запустится без него (ни локально, ни в docker compose up —
# compose явно откажет на этапе интерполяции .env, если переменная не задана).
JWT_SECRET=
JWT_TTL_MINUTES=1440

# Защита публичных форм (POST /api/v1/leads, POST /api/v1/reviews) от спама
# TRUSTED_PROXIES — адреса/подсети (CIDR) прокси перед приложением, которым можно верить
# в X-Forwarded-For (через запятую). Локально и при nginx на том же хосте, а приложение
# запущено не в Docker — 127.0.0.1,::1. Приложение в Docker за nginx на хосте — nginx
# приходит с адреса docker-сети, см. значение по умолчанию в docker-compose.yml.
# Пусто — не доверять никому (IP клиента всегда берется из соединения).
TRUSTED_PROXIES=127.0.0.1,::1

# Не больше MAX запросов с одного IP за WINDOW_MINUTES; MAX=0 — без ограничения
LEAD_RATE_LIMIT_MAX=5
LEAD_RATE_LIMIT_WINDOW_MINUTES=10

REVIEW_RATE_LIMIT_MAX=3
REVIEW_RATE_LIMIT_WINDOW_MINUTES=60

# Повторная заявка/отзыв с тем же телефоном в течение окна отклоняется (429); 0 — без проверки
LEAD_DUPLICATE_WINDOW_MINUTES=10
REVIEW_DUPLICATE_WINDOW_MINUTES=1440
